{
  "expo": {
    "name": "Waghmare Vikas",
    "slug": "loan-management-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12153A"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.loanmanager.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12153A"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loanmanager.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph payment receipts.",
        "NSPhotoLibraryUsageDescription": "Used to attach payment receipt images."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
